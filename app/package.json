{
  "name": "tasuku-app",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "stack:up": "supabase start && node scripts/seed.mjs",
    "stack:reset": "supabase db reset && node scripts/seed.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "check-i18n": "node ../storybook/scripts/check-i18n.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.3"
  }
}
